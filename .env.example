# Copy to .env and fill in. Never commit real values.

# ---- Backend (Spring Boot: environment variables, or backend/.env) ----
# Supabase Postgres password
SUPABASE_DB_PASSWORD=
# HMAC key for signing JWTs (Base64, at least 256 bits)
JWT_SECRET=
# Comma-separated frontend origins allowed by CORS and the WebSocket, e.g. the deployed site URL
CORS_ALLOWED_ORIGINS=
# SMTP account for verification and password-reset emails
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# ---- docker-compose (local Postgres container) ----
POSTGRES_PASSWORD=

# ---- Frontend ----
# Vite reads its VITE_ variables from frontend/.env: see frontend/.env.example
