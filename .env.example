# Copy to .env (repository root) and fill in. Never commit real values.
# docker-compose reads this file. A backend run outside Docker reads the same names from its
# environment or from backend/.env.
#
# Lines marked "required for docker-compose" must have a value or `docker compose` stops.
# For a backend run outside Docker, delete any line you leave empty: Spring treats an empty
# variable as a value, not as "use the default".

# ---- Local PostgreSQL container (required for docker-compose) ----
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# ---- Shared Supabase database (backend run outside Docker) ----
SUPABASE_DB_PASSWORD=

# ---- Auth ----
# HMAC key for signing JWTs, Base64, at least 256 bits (required for docker-compose)
JWT_SECRET=
# Google OAuth client ID (must match VITE_GOOGLE_CLIENT_ID for Google Sign-In)
GOOGLE_CLIENT_ID=
# Comma-separated frontend origins allowed by CORS and the WebSocket
CORS_ALLOWED_ORIGINS=
# SMTP account for verification, password-reset and parcel-status emails (backend run outside
# Docker). With Gmail, use the sender account's app password, not its normal password.
# docker-compose sends all email to its Mailpit container instead (inbox: http://localhost:8025);
# there SPRING_MAIL_USERNAME is only the sender address (default no-reply@example.com) and the
# password is not used.
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# ---- RabbitMQ: status events, outbox relay, merchant webhooks ----
# docker-compose creates this user in the rabbitmq container and gives the same values to the
# backend container (required for docker-compose). The broker's built-in "guest" user is refused
# for connections from outside the container, so a backend run outside Docker needs these too.
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
# Backend run outside Docker only (defaults: localhost, 5672, /)
RABBITMQ_HOST=
RABBITMQ_PORT=
RABBITMQ_VHOST=
# Optional tuning (defaults in application.properties)
OUTBOX_POLL_INTERVAL_MS=
WEBHOOK_RETRY_DELAYS=

# ---- MinIO: courier delivery-proof photos ----
# Photo proof is unavailable until all three of endpoint, access key and secret key are set.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# Bucket name (default: delivery-proofs)
MINIO_PROOF_BUCKET=

# ---- AI delivery assistant (OpenAI-compatible endpoint) ----
# The assistant answers "not configured" until AI_API_KEY is set.
AI_API_KEY=
# Defaults: https://api.openai.com/v1 and gpt-4o-mini
AI_BASE_URL=
AI_MODEL=
# Most tool-calling rounds per question, and seconds to wait for the AI provider
AI_MAX_ITERATIONS=5
AI_TIMEOUT_SECONDS=30

# ---- Dev profile only (SPRING_PROFILES_ACTIVE=dev) ----
# Password for the demo merchant test.merchant@example.com. If unset, a random one is generated
# and logged once when the demo merchant is first created.
DEV_MERCHANT_PASSWORD=
# Password for the dev test accounts test.customer@, test.courier@, test.dispatcher@ and
# test.admin@example.com. If unset, each gets a random one, logged once when it is created.
DEV_USER_PASSWORD=
# true = publish status events to the local RabbitMQ and run its listeners (webhooks, notifications)
DEV_MESSAGING_ENABLED=

# ---- Frontend ----
# Vite reads its VITE_ variables from frontend/.env: see frontend/.env.example
