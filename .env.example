# Copy to .env (repository root) and fill in. Never commit real values.
# docker-compose reads this file. A backend run outside Docker reads the same names from its
# environment or from backend/.env.
#
# Lines marked "required for docker-compose" must have a value or `docker compose` stops.
# For a backend run outside Docker, delete any line you leave empty: Spring treats an empty
# variable as a value, not as "use the default".

# ---- Local PostgreSQL container (required for docker-compose) ----
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# ---- Shared Supabase database (backend run outside Docker) ----
SUPABASE_DB_PASSWORD=

# ---- Auth ----
# HMAC key for signing JWTs, Base64, at least 256 bits (required for docker-compose)
JWT_SECRET=
# Comma-separated frontend origins allowed by CORS and the WebSocket
CORS_ALLOWED_ORIGINS=
# SMTP account for verification and password-reset emails
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# ---- RabbitMQ: status events, outbox relay, merchant webhooks ----
# docker-compose creates this user in the rabbitmq container and gives the same values to the
# backend container (required for docker-compose). The broker's built-in "guest" user is refused
# for connections from outside the container, so a backend run outside Docker needs these too.
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
# Backend run outside Docker only (defaults: localhost, 5672, /)
RABBITMQ_HOST=
RABBITMQ_PORT=
RABBITMQ_VHOST=
# Optional tuning (defaults in application.properties)
OUTBOX_POLL_INTERVAL_MS=
WEBHOOK_RETRY_DELAYS=

# ---- MinIO: courier delivery-proof photos ----
# Photo proof is unavailable until all three of endpoint, access key and secret key are set.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# Bucket name (default: delivery-proofs)
MINIO_PROOF_BUCKET=

# ---- Frontend ----
# Vite reads its VITE_ variables from frontend/.env: see frontend/.env.example
