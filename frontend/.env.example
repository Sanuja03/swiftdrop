# Copy to frontend/.env and fill in. Never commit real values.

# Backend origin, e.g. https://api.example.com. Leave empty to call the same origin
# (the Vite dev proxy and the nginx container forward /api and /ws to the backend).
VITE_API_BASE_URL=

# Google OAuth client ID for "Sign in with Google"
VITE_GOOGLE_CLIENT_ID=

# Dev server only: backend the Vite proxy forwards to (defaults to http://localhost:8080)
VITE_DEV_PROXY_TARGET=
